{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winnie",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 — Winnie's own data (users, connectors, pending_actions,
  // audit_log, ai_calls). Code reads `env.DB`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "winnie-db",
      "database_id": "a41ddd4d-75a7-4af1-adbf-4143713d2bde",
      "migrations_dir": "migrations"
    }
  ],

  // Build/deploy entry and asset wiring are added at Step 8 once
  // OpenNext for Cloudflare is configured.
  "vars": {
    // Filled at Step 8 with real values per environment.
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "AI_GATEWAY_URL": ""
  }
}
